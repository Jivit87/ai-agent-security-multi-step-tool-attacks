#!/usr/bin/env python3
"""Kaggle AI Agent Security - Hermes v59-pure-n1100-std-20260719-002609"""

import base64, sys, subprocess, importlib
from pathlib import Path

# ── Install SDK from competition input ──
sdk_wheels = list(Path("/kaggle/input/ai-agent-security-multi-step-tool-attacks").glob("*.whl"))
if sdk_wheels:
    subprocess.check_call(["pip", "install", "-q", str(sdk_wheels[0])])
    importlib.invalidate_caches()

# ── Decode and write attack.py ──
code = base64.b64decode("""""".encode()).decode()
Path("/kaggle/working/attack.py").write_text(code)
print("[OK] Wrote /kaggle/working/attack.py (" + str(len(code)) + " bytes)")

# ── Write placeholder submission.csv (ensures submission file exists even if attack produces no candidates) ──
placeholder_path = Path("/kaggle/working/submission.csv")
if not placeholder_path.exists():
    placeholder_path.write_text("model,guardrail,score\nplaceholder,placeholder,0.0")
    print("[OK] Wrote placeholder submission.csv")
else:
    print("[OK] submission.csv already exists (" + str(placeholder_path.stat().st_size) + " bytes)")

# ── Start inference server ──
sys.path.insert(0, "/kaggle/working")
from kaggle_evaluation.jed_attack_134815.jed_attack_inference_server import JEDAttackInferenceServer
server = JEDAttackInferenceServer()
print("[*] Starting JEDAttackInferenceServer...")
server.serve()
